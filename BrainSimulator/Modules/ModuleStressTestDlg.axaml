<Window x:Class="BrainSimulator.Modules.ModuleStressTestDlg"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:local="clr-namespace:BrainSimulator"
        Title="Stress test the system" Width="700" ShowInTaskbar="False">
	<StackPanel Orientation="Vertical">
	    <Grid Name="theGrid" Classes="RootGrid" >
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="100"/>
				<ColumnDefinition Width="100"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>
			<!-- Row 0 -->
			<Label Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Content="Used to stress test by adding toy examples. &#10;Enter the amount of examples you want to add." />

			<!-- Row 1 -->
			<TextBox Grid.Row="1" Grid.Column="0" Name="textInput" TextWrapping="Wrap" Text="1000" />
			<Button Grid.Row="1" Grid.Column="1" Content="Add Items" Click="Button_Click" />

			<!-- Row 2 -->
			<TextBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Name="txtOutput" TextWrapping="Wrap" Text=""/>
			
			<!-- Row 3 -->
			<Label Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Name="StatusLabel" Content="" />
        </Grid>
		<local:ModuleFooter />
	</StackPanel>		
</Window>
