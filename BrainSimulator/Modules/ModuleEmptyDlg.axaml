<Window x:Class="BrainSimulator.Modules.ModuleEmptyDlg"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:local="clr-namespace:BrainSimulator"
        Title="Empty Dialog Template" Width="560" ShowInTaskbar="False" >
    <Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>
		<local:ModuleFooter Grid.Row="0" Grid.Column="0"/>
    </Grid>
</Window>
