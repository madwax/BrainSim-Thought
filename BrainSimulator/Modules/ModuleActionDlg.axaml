<Window x:Class="BrainSimulator.Modules.ModuleActionDlg"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:local="clr-namespace:BrainSimulator"
        Title="Action" 
		Width="320" 
		ShowInTaskbar="False" >
	<StackPanel Orientation="Vertical">
        <Grid Classes="RootGrid" SizeChanged="Grid_SizeChanged">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
			    <RowDefinition Height="Auto"/>
		    </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Last Context:"/>
            <TextBox Name="LastContextTextBox"
                     Grid.Row="0" Grid.Column="1"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     VerticalContentAlignment="Center"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Last Action:"/>
            <TextBox Name="LastActionTextBox"
                     Grid.Row="2" Grid.Column="1"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     VerticalContentAlignment="Center"/>
    	</Grid>
	    <local:ModuleFooter />
    </StackPanel>
</Window>