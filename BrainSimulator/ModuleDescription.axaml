<Window x:Class="BrainSimulator.ModuleDescriptionDlg"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		SizeToContent="WidthAndHeight"
        Title="Description" >
    <Grid RowSpacing="5" ColumnSpacing="5" Margin="10">
		<Grid.RowDefinitions>
			<RowDefinition Height="50"/>
			<RowDefinition Height="50"/>
			<RowDefinition Height="50"/>
			<RowDefinition Height="50"/>
			<RowDefinition Height="50"/>
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="100"/>
			<ColumnDefinition Width="100"/>
			<ColumnDefinition Width="100"/>
			<ColumnDefinition Width="100"/>
			<ColumnDefinition Width="100"/>
			<ColumnDefinition Width="100"/>
			<ColumnDefinition Width="100"/>
		</Grid.ColumnDefinitions>		
		<!-- Row 0 -->
		<TextBlock Grid.Row="0" Grid.Column="2" Text="Select Module Type:"/>
		<ComboBox Grid.Row="0" Grid.Column="3" Grid.ColumnSpan="3" Name="moduleSelector" SelectionChanged="moduleSelector_SelectionChanged"/>

		<!-- Row 1 -->
		<TextBlock Grid.Row="1" Grid.Column="0" Text="Description:" />

		<!-- Row 2 Have to set w/h -->
		<TextBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="7" Name="Description" ScrollViewer.VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Text="Description Text" AcceptsReturn="True" Background="LightBlue"/>

		<!-- Row 3 - Empty -->

		<!-- Row 4 -->
		<Button Grid.Row="4" Grid.Column="5" Name="buttonSave" Content="Save" Click="Button_Click" ToolTip.Tip="Saves the edited text, but does not close the dialog." />
        <Button Grid.Row="4" Grid.Column="6" Name="buttonClose" Content="Close" Click="buttonClose_Click" ToolTip.Tip="Closes the dialog, without saving any changes."/>
    </Grid>
</Window>
